<Project>
  <!--
    Keep source/line information in Release stack traces without embedding the
    workstation or GitHub runner checkout path in portable PDBs.

    Example shipped path:
      /_/src/RavaFit.Plugin/Services/SolverHostService.cs:line 139
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
